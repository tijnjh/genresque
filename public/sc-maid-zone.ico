<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>soundcloak</title></head><body><style>
@font-face {
    font-family: "Fixed Medium";
    src: url("/fixed.ttf");
}

:root {
    /* github.com/material-ocean */
    --accent: #ff4151;
    --primary: #0f111a;
    --secondary: #00010a;
    --0: #3b4252;
    --text: white;
}

* {
    margin: 0;
    padding: 0;
    min-width: 0;
    touch-action: manipulation;
    font-family: "Fixed Medium", monospace !important;
}

html {
    height: 100%;
}

body {
    font-family: "Fixed Medium", monospace;
    background-color: var(--primary);
    color: var(--text);
    line-height: 0.99;
    min-height: 100%;
    margin: 0;
    padding: 0;
    font-size: 1.25rem;
}

main {
    max-width: 45rem;
    margin-inline: auto;
    padding: 1rem;
    padding-block-end: 6rem;
}

main h1,
main h2,
main h3 {
    font-weight: normal;
    margin-block: 1rem;
}

main h1 {
    font-size: clamp(2.5rem, 10vw, 4rem);
    margin-block-end: clamp(1rem, 5vw, 3rem);
}

p {
    padding-block-end: 1rem;
    margin-inline: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

.btn {
  background-color: var(--secondary);
  color: var(--text);
  border-color: var(--0);
  border-style: solid;
  cursor: pointer;
  padding: 0.5rem 0.75rem;
  display: block;
  text-align: center;
  margin: 2rem 0 2rem;
}

.btn:hover,
.btn:focus,
.btn.active {
  border-color: var(--accent);
  border-style: solid;
  outline: none;
}

.good {
    color: #a3be8c
}

.okay {
    color: #ebcb8b
}

.bad {
    color: #bf616a
}
            </style><main><h1>Select Server</h1><p>Instances in multiple locations are available. It's recommended to select the one with lowest latency :) <noscript><br>JavaScript is disabled, so you can only measure it manually</noscript></p><div><a class="btn" href="https://sc1.maid.zone//favicon.ico"><h2>🇩🇪 Frankfurt, Germany</h2><p>sc1.maid.zone <br><i>previously sc.maid.zone</i></p><span id="fra" class="latency"></span></a><a class="btn" href="https://sc2.maid.zone//favicon.ico"><h2>🇯🇵 Tokyo, Japan</h2><p>sc2.maid.zone </p><span id="tyo" class="latency"></span></a><a class="btn" href="https://sc3.maid.zone//favicon.ico"><h2>🇺🇸 Buffalo, New York, USA</h2><p>sc3.maid.zone </p><span id="buf" class="latency"></span></a></div><script>
                    // professionalyl stolen (with modification) code
                    const servers = {}
                    for (const s of document.getElementsByClassName("latency")) {
                        servers[s.id] = null
                        s.parentElement.onclick = () => document.cookie = "server=" + s.id + "; expires=Tue, 19 Jan 2038 03:14:07 UTC"
                    }

                    function connect(server) {
                        const ws = new WebSocket("wss://"+server+".maid.zone/ping")
                        let last = null

                        ws.onopen = () => {
                            if (ws.readyState === WebSocket.OPEN) {
                                last = performance.now()
                                ws.send("ping")
                            }
                        }
                        ws.onmessage = () => {
                            if (last !== null) {
                                const latency = performance.now() - last
                                const el = document.getElementById(server)
                                if (latency <= 100) {
                                    el.className = "good"
                                } else if (latency <= 200) {
                                    el.className = "okay"
                                } else {
                                    el.className = "bad"
                                }
                                el.textContent = latency+"ms"
                                last = null
                            }
                        }
                        ws.onclose = e => {
                            document.getElementById(server).textContent = e.reason
                            setTimeout(() => connect(server), 1000)
                        }

                        servers[server] = ws
                    }

                    for (const server in servers) {
                        connect(server)
                    }

                    setInterval(() => {
                        for (const server in servers) {
                            try {
                                servers[server].onopen()
                            } catch (e) { console.error(e) }
                        }
                    }, 1000)
    
    </script></main></body></html>